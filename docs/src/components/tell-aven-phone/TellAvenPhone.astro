---
import './tell-aven-phone.css';

const followUp = 'Also push the flaky CI test to Monday and make it urgent';
const request = 'Add a task to rotate the staging API keys before Friday’s release and label it security.';
---

<div class="tp" data-tell-phone data-request={request} data-follow-up={followUp} role="img" aria-label="Tell Aven on iPhone: a spoken request is transcribed live and becomes a new task; a typed follow-up finds an existing task and moves it to Monday as urgent. Each set of changes is reviewed, then applied to the queue.">
  <div class="tp-screen" aria-hidden="true">
    <div class="tp-island"></div>
    <div class="tp-status">
      <span class="tp-time">9:41</span>
      <span class="tp-indicators">
        <svg width="17" height="11" viewBox="0 0 17 11"><rect x="0" y="7" width="3" height="4" rx="1"/><rect x="4.5" y="5" width="3" height="6" rx="1"/><rect x="9" y="2.5" width="3" height="8.5" rx="1"/><rect x="13.5" y="0" width="3" height="11" rx="1"/></svg>
        <svg width="15" height="11" viewBox="0 0 15 11"><path d="M7.5 2.2c2.1 0 4 .8 5.4 2.1l1.1-1.1A9.2 9.2 0 0 0 7.5.6 9.2 9.2 0 0 0 1 3.2l1.1 1.1a7.6 7.6 0 0 1 5.4-2.1Zm0 3.2c1.2 0 2.4.5 3.2 1.3l1.1-1.1a6.1 6.1 0 0 0-8.6 0l1.1 1.1c.8-.8 2-1.3 3.2-1.3Zm0 3.2c-.4 0-.8.2-1.1.5L7.5 10.2l1.1-1.1a1.6 1.6 0 0 0-1.1-.5Z"/></svg>
        <span class="tp-battery"><i></i></span>
      </span>
    </div>

    <div class="tp-sheet">
      <span class="tp-grabber"></span>
      <div class="tp-nav">
        <span class="tp-pill tp-pill-icons">
          <svg viewBox="0 0 24 24"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4.5h4.5M12 7.5V12l3 2"/></svg>
          <svg viewBox="0 0 24 24"><path d="M11 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5M17.5 3.5l3 3L12 15l-4 1 1-4 8.5-8.5Z"/></svg>
        </span>
        <b>Tell Aven</b>
        <span class="tp-pill tp-done">Done</span>
      </div>

      <div class="tp-thread">
       <div class="tp-scroll">
        <div class="tp-intro">
          <span class="tp-intro-mark"><svg viewBox="0 0 24 24"><path d="M6 4h12a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-8l-4.5 3.5V18H6a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3Z"/><path d="m8.5 11 2.5 2.5 4.5-5"/></svg></span>
          <b>What’s on your mind?</b>
          <p>Add a few tasks, tidy up your inbox, or ask what’s coming up. Type it or just say it.</p>
        </div>
        <p class="tp-bubble">{request}</p>
        <p class="tp-step tp-step-1"><span class="tp-tick">✓</span><span class="tp-spin"></span>Read projects and labels</p>
        <p class="tp-step tp-step-2"><span class="tp-tick">✓</span><span class="tp-spin"></span>Drafted new task</p>
        <p class="tp-reply">I’ll add this to the app project with the security label, due Friday.</p>
        <div class="tp-card">
          <span class="tp-mark"><svg viewBox="0 0 24 24"><path d="m7 12.5 3.2 3.2L17 9"/></svg></span>
          <div class="tp-card-body">
            <small>New task</small>
            <strong>Rotate staging API keys</strong>
            <span class="tp-ref">APP-K2TM</span>
            <span class="tp-meta"><span class="tp-chip"><svg viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></svg>app</span><span data-date="friday">Friday</span></span>
            <span class="tp-detail">Labels: security</span>
            <span class="tp-desc"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 10h16M4 14h16M4 18h10"/></svg><span>Rotate before the Friday release so the old keys stop working</span><i>›</i></span>
          </div>
          <i class="tp-chevron">›</i>
        </div>
        <p class="tp-bubble tp-bubble-2">{followUp}</p>
        <p class="tp-step tp-step-3"><span class="tp-tick">✓</span><span class="tp-spin"></span>Searched ‘flaky CI’ · 1 task</p>
        <p class="tp-step tp-step-4"><span class="tp-tick">✓</span><span class="tp-spin"></span>Drafted update</p>
        <p class="tp-reply tp-reply-2">I’ll move the flaky CI test to Monday and raise it to urgent.</p>
        <div class="tp-card tp-card-2">
          <span class="tp-mark"><svg viewBox="0 0 24 24"><path d="m7 12.5 3.2 3.2L17 9"/></svg></span>
          <div class="tp-card-body">
            <small>Update task</small>
            <strong>Fix flaky CI sync test caused by retry backoff clock skew</strong>
            <span class="tp-ref">AVN-WV80</span>
            <span class="tp-detail">Due: <s data-date="friday">Friday</s> → <span data-date="monday">Monday</span></span>
            <span class="tp-detail">Priority: <s>High</s> → Urgent</span>
          </div>
          <i class="tp-chevron">›</i>
        </div>
       </div>
      </div>

      <div class="tp-dock">
        <div class="tp-review"><b>1 change pending</b><span class="tp-btn">Discard</span><span class="tp-btn tp-apply">Apply 1</span></div>
        <div class="tp-receipt"><span><b>✓ Applied 1 change</b><small>Saved and syncing</small></span><span class="tp-btn">↺ Undo</span></div>
        <div class="tp-text"><span class="tp-placeholder">Tell Aven…</span><span class="tp-typed"></span><span class="tp-transcript"><span class="tp-settled"></span><span class="tp-volatile"></span></span></div>
        <div class="tp-toolbar">
          <span class="tp-slot tp-photo"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10" r="1.5"/><path d="m21 16-5-5-8 8"/></svg></span>
          <span class="tp-slot tp-cancel"><svg viewBox="0 0 24 24"><path d="M7 7l10 10M17 7 7 17"/></svg></span>
          <canvas class="tp-wave"></canvas>
          <span class="tp-slot tp-mic"><svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"/></svg></span>
          <span class="tp-slot tp-stop"><svg viewBox="0 0 24 24"><rect x="7" y="7" width="10" height="10" rx="2"/></svg></span>
          <span class="tp-slot tp-send"><svg viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6"/></svg></span>
        </div>
      </div>
      <span class="tp-home"></span>
    </div>
  </div>
</div>

<script>
  import { play } from './player';

  document.querySelectorAll<HTMLElement>('[data-tell-phone]').forEach((phone) => play(phone));
</script>
