---
import '../../styles/agent-sessions.css';
import ArrowRightIcon from '../ArrowRightIcon.astro';
import { scenes, STATIC_SCENE, queueBefore, queueHTML } from './story';

const staticQueue = queueBefore(STATIC_SCENE + 1);
---

<section class="section agent-section" aria-labelledby="agents-heading" data-agent-sessions>
  <div class="section-copy">
    <p class="eyebrow">Agent-first CLI</p>
    <h2 id="agents-heading">Your agents work the same queue as you.</h2>
    <p>Turn “fix this later” into a task with the context attached. Start another agent on it later. Decisions, progress, and blockers are saved as notes on the task.</p>
    <ol class="scene-list" role="tablist" aria-label="Agent use cases">
      {scenes.map((scene, i) => (
        <li>
          <button type="button" role="tab" aria-selected={String(i === STATIC_SCENE)} data-tab={i}>
            <b><i>{i + 1}</i>{scene.name}</b>
            <span>{scene.line}</span>
          </button>
        </li>
      ))}
    </ol>
    <a class="text-link" href="/agents/">Work with agents <ArrowRightIcon /></a>
  </div>
  <div>
    <div class="terminal" role="region" aria-label="Example agent sessions">
      <div class="session-titlebar"><span class="session-title">{scenes[STATIC_SCENE].title}</span><span class="session-example">example</span></div>
      <div class="chapters">
        {scenes.map((scene, i) => (
          <div class:list={['chapter', { on: i === STATIC_SCENE }]} data-title={scene.title}>
            <div class="viewport" tabindex="0">
              <div class="feed terminal-session">
                {scene.start && <p class="session-start step" data-ch={i}>{scene.start}</p>}
                {scene.steps.map((step) => {
                  switch (step.kind) {
                    case 'earlier':
                      return <p class="session-start">{step.text}</p>;
                    case 'context':
                      return <p class="session-answer" set:html={step.html} />;
                    case 'user':
                      return (
                        <div class:list={['session-user step', { typed: step.typed }]}>
                          <span class="session-user-label">User</span>
                          <p class="type" set:html={step.html} />
                        </div>
                      );
                    case 'tool':
                      return (
                        <div class="session-tool step" data-fx={step.fx ?? ''} data-ms={step.ms ?? 120}>
                          <span aria-hidden="true"></span>
                          <strong class="tool-name">{step.name}</strong> <code>{step.cmd}</code>
                          {(step.body ?? []).map((line) => <code class="l">{line}</code>)}
                          {(step.result ?? []).map((r, j) => {
                            const { text, fx } = typeof r === 'string' ? { text: r, fx: undefined } : r;
                            return <samp class:list={['result', { more: j > 0, empty: !text }]} data-fx={fx}>{text || '(No content)'}</samp>;
                          })}
                        </div>
                      );
                    case 'agent':
                      return (
                        <p class="session-answer step stream">
                          <Fragment set:html={step.html} />
                          {step.cursor && <span class="terminal-cursor" aria-hidden="true"></span>}
                        </p>
                      );
                    case 'proposal':
                      return (
                        <div class="session-answer step stream">
                          <p>{step.intro}</p>
                          <ul>{step.items.map((item) => <li>{item}</li>)}</ul>
                        </div>
                      );
                  }
                })}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="q" role="img" aria-label="aven queue for project app, updating as the agent runs aven commands">
      <div class="q-bar"><b>aven</b><span>project <b>app</b></span><span>view <b>queue</b></span><span class="q-count">queue {staticQueue.tasks.length}</span></div>
      <div class="q-head"><span>REF</span><span>TITLE</span><span></span><span>STATUS</span><span>P</span></div>
      <div class="q-list" set:html={queueHTML(staticQueue)} />
    </div>
  </div>
</section>

<script>
  import { arm } from './player';

  document.querySelectorAll<HTMLElement>('[data-agent-sessions]').forEach((section) => arm(section));
</script>
