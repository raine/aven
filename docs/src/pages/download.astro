---
import Brand from '../components/Brand.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import ExternalLinkIcon from '../components/ExternalLinkIcon.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { linuxInstall, linuxUninstall, macAppleSilicon, macIntel } from '../downloads';
import '../styles/landing.css';
import '../styles/download.css';

const terminal = [
  { label: 'Install script', command: 'curl -fsSL https://raw.githubusercontent.com/raine/aven/main/scripts/install | bash' },
  { label: 'Homebrew', command: 'brew install raine/aven/aven' },
  { label: 'Nix', command: 'nix profile install https://github.com/raine/aven/releases/latest/download/aven-nix.tar.gz' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#121110" />
    <title>Download Aven | aven</title>
    <meta name="description" content="Download Aven for Mac and Linux, install it in the terminal only, or get the iPhone and Android apps." />
    <link rel="canonical" href="https://aventasks.dev/download/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Download Aven | aven" />
    <meta property="og:description" content="Aven for Mac, Linux, the terminal, iPhone and Android." />
    <meta property="og:url" content="https://aventasks.dev/download/" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="container">
      <header class="site-header">
        <Brand />
        <nav aria-label="Main navigation">
          <a class="features-link" href="/#features">Features</a>
          <a href="/sync/">Sync</a>
          <a href="/mobile/">Mobile</a>
          <a href="/getting-started/">Docs</a>
          <a href="https://github.com/raine/aven"><GitHubIcon /> GitHub</a>
        </nav>
      </header>

      <main id="main" class="download">
        <h1>Download Aven</h1>
        <p class="download-lead">The same tasks on your computer, in your terminal and on your phone.</p>

        <section class="download-platform" id="mac" aria-labelledby="mac-heading">
          <div class="download-platform-head">
            <h2 id="mac-heading">Mac</h2>
            <p>macOS 13 or later</p>
          </div>
          <p>Aven Desktop, with the <code>aven</code> command for your terminal and agents included. Updates itself.</p>
          <div class="download-mac">
            <a class="download-button" href={macAppleSilicon}>Download for Apple silicon</a>
            <p class="download-intel">Intel Mac? <a href={macIntel}>Download for Intel</a></p>
          </div>
          <p class="download-label">Or with Homebrew</p>
          <div class="download-command"><span aria-hidden="true">$</span><code>brew install --cask raine/aven/aven</code><button type="button" data-copy>copy</button></div>
          <p class="download-note">Open the disk image and drag Aven to Applications. Already use Aven in the terminal? Setup moves that install over and keeps your tasks and sync.</p>
        </section>

        <section class="download-platform" id="linux" aria-labelledby="linux-heading">
          <div class="download-platform-head">
            <h2 id="linux-heading">Linux</h2>
            <p>x86-64 and ARM64</p>
          </div>
          <p>Aven Desktop, installed for your user, with the <code>aven</code> command included. Needs glibc 2.35 or newer and Wayland or X11.</p>
          <div class="download-command download-command-first"><span aria-hidden="true">$</span><code>{linuxInstall}</code><button type="button" data-copy>copy</button></div>
          <p class="download-label">Uninstall, keeping your tasks and settings</p>
          <div class="download-command"><span aria-hidden="true">$</span><code>{linuxUninstall}</code><button type="button" data-copy>copy</button></div>
          <p class="download-note">Run the installer again to update. Just the terminal? Use a <a href="#terminal">terminal-only install</a>.</p>
        </section>

        <section class="download-platform" id="terminal" aria-labelledby="terminal-heading">
          <div class="download-platform-head">
            <h2 id="terminal-heading">Terminal only</h2>
            <p>macOS and Linux</p>
          </div>
          <p>The TUI and the <code>aven</code> CLI, without the Mac app.</p>
          {terminal.map((option) => (
            <>
              <p class="download-label">{option.label}</p>
              <div class="download-command"><span aria-hidden="true">$</span><code>{option.command}</code><button type="button" data-copy>copy</button></div>
            </>
          ))}
        </section>

        <section class="download-platform" id="phone" aria-labelledby="phone-heading">
          <div class="download-platform-head">
            <h2 id="phone-heading">iPhone and Android</h2>
          </div>
          <p>Joins the sync you run from your computer. <a href="/mobile/">About the phone apps</a></p>
          <StoreBadges class="download-stores" />
        </section>
      </main>

      <footer class="site-footer">
        <div><Brand /></div>
        <nav aria-label="Footer navigation"><a href="/getting-started/">Docs</a><a href="/changelog/">Changelog</a><a href="/about/">About</a><a href="/support/">Support</a><a href="/privacy/">Privacy</a><a href="https://github.com/raine/aven">Source <ExternalLinkIcon /></a><a href="https://x.com/aventasksdev">X <ExternalLinkIcon /></a></nav>
      </footer>
    </div>
  </body>
</html>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const label = button.textContent;
    const command = button.parentElement!.querySelector('code')!;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(command.textContent!);
        button.textContent = 'copied';
        setTimeout(() => (button.textContent = label), 1500);
      } catch {
        const range = document.createRange();
        range.selectNodeContents(command);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
    });
  });
</script>
