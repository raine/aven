---
import logo from '../assets/aven-logo-grape-violet.svg';
import wordmark from '../assets/aven-landing-wordmark.svg';
import '../styles/landing.css';
import ExternalLinkIcon from '../components/ExternalLinkIcon.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import Brand from '../components/Brand.astro';
import ArrowRightIcon from '../components/ArrowRightIcon.astro';
import SyncTopology from '../components/SyncTopology.astro';
import AgentSessions from '../components/agent-sessions/AgentSessions.astro';
import QuickCapture from '../components/QuickCapture.astro';

const heroViews = [
  { id: 'queue', caption: 'See what needs attention across your projects.', label: 'Queue', src: '/tui.webp', alt: 'Aven terminal UI showing a shared task queue, project sidebar, priorities, and selected task context.' },
  { id: 'detail', caption: 'Keep descriptions, notes, and dependencies together.', label: 'Task', src: '/task-detail.webp', alt: "Aven task detail showing a Markdown description alongside the task's project, status, priority, labels, and reference." },
  { id: 'columns', caption: 'See tasks grouped by status.', label: 'Columns', src: '/columns.webp', alt: 'Aven columns view showing tasks grouped into Inbox, Backlog, Todo, Active, and Done.' },
  { id: 'add-task', caption: 'Capture a task without leaving the keyboard.', label: 'Add task', src: '/add-task.webp', alt: 'Aven task composer over the queue, with title, description, project, status, priority, labels, and schedule fields.' },
  { id: 'search', caption: 'Find tasks across titles and descriptions.', label: 'Search', src: '/search.webp', alt: 'Aven search for offline showing three tasks across projects, with matches in task titles and descriptions.' },
  { id: 'commands', caption: 'Find commands without memorizing every shortcut.', label: 'Commands', src: '/hero-commands.webp', alt: 'Aven command palette filtering view commands over the queue, showing command names, keyboard shortcuts, and descriptions.' },
];

const appStoreUrl = 'https://apps.apple.com/app/aven-tasks/id6811171767';
const playStoreUrl = 'https://play.google.com/store/apps/details?id=fi.zendit.aven';
const pairingVideoLabel = 'Pairing an iPhone: open Add device in the Aven TUI, scan the QR code with the iPhone app, and the queue appears on the phone. A task opens and its Markdown description scrolls.';

const features = [
  { label: '▸ NEEDS ACTION · FOCUS · SOON', title: 'Separate projects. One queue.', description: 'See what needs attention across your projects, or narrow your scope. Use separate workspaces to keep independent task collections apart.', color: 'violet', href: '/organize-tasks/' },
  { label: 'DUE DATES · RECURRING', title: 'Give work its own time.', description: 'Due dates, deferred tasks, and recurring schedules. Keep later work out of the way until it belongs in front of you.', color: 'orange', href: '/schedule-tasks/' },
  { label: 'MARKDOWN · NOTES · IMAGES', title: 'Keep the context attached.', description: 'Markdown, notes, images, epics, and dependencies. Pick up where you left off, or copy a Markdown task report for handoffs.', color: 'pink', href: '/concepts/' },
  { label: 'KEYS · COMMANDS · UNDO', title: 'Stay on the keyboard.', description: 'Move, filter, edit, and undo without reaching for the mouse. A command palette fills in the gaps.', color: 'blue', href: '/tui/' },
  { label: 'SQLITE · OFFLINE', title: 'Local is the default.', description: 'Your tasks live in SQLite, outside your repositories. Work offline. Switch branches. Keep your data.', color: 'green', href: '/backups/' },
  { label: 'SYNC · SELF-HOSTED · E2EE', title: 'Sync you control', description: 'Works fully offline. Need it on more machines? Run the sync server on a Raspberry Pi and connect over your own network. Sync is end-to-end encrypted, so the server cannot read your tasks.', color: 'yellow', href: '/sync/' },
];
const testimonials = [
  { quote: "This is by far the best TUI application I've come across in months.", author: 'Edke', source: 'GitHub', href: 'https://github.com/raine/aven/issues/5#issuecomment-5048980472' },
  { quote: 'I am really impressed by the functionality at this early stage. Became a default tool for me already and serves also as shared memory and persistent learnings for my agents.', author: 'André Schemaitat', source: 'LinkedIn', featured: true, href: 'https://www.linkedin.com/posts/schemaitat_tool-recommendation-for-local-task-management-share-7486060060650016768-5WRG/' },
  { quote: "I'm having a blast using the TUI, UX is perfect.", author: 'xe6', source: 'GitHub', href: 'https://github.com/raine/aven/pull/19#issuecomment-5455250814' },
  { quote: "It's a genuinely beautiful TUI and a really promising task manager.", author: 'sudoremo', source: 'GitHub', href: 'https://github.com/raine/aven/issues/3' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#121110" />
    <title>aven | Your tasks, everywhere. Agent-ready.</title>
    <meta name="description" content="A local-first task manager for power users and coding agents. A keyboard-first terminal UI, a compact CLI, and one shared queue. Your tasks live in SQLite. Sync is optional." />
    <link rel="canonical" href="https://aventasks.dev/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="aven | Your tasks, everywhere. Agent-ready." />
    <meta property="og:description" content="Local-first task management for power users and coding agents." />
    <meta property="og:url" content="https://aventasks.dev/" />
    <meta property="og:image" content="https://aventasks.dev/aven-social.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="Aven: Your tasks. Your terminal. A terminal task queue alongside the Aven logo." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="aven | Your tasks, everywhere. Agent-ready." />
    <meta name="twitter:description" content="Local-first task management for power users and coding agents." />
    <meta name="twitter:image" content="https://aventasks.dev/aven-social.png" />
    <meta name="twitter:image:alt" content="Aven: Your tasks. Your terminal. A terminal task queue alongside the Aven logo." />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="container">
      <header class="site-header">
        <Brand />
        <nav aria-label="Main navigation">
          <a class="features-link" href="#features">Features</a>
          <a href="/sync/">Sync</a>
          <a href="/mobile/">Mobile</a>
          <a href="/getting-started/">Docs</a>
          <a href="https://github.com/raine/aven"><GitHubIcon /> GitHub</a>
        </nav>
      </header>

      <main id="main">
        <section class="hero" style={`--hero-logo: url("${logo.src}")`} aria-labelledby="hero-heading">
          <p class="eyebrow hero-eyebrow">Local-first task management</p>
          <div class="hero-intro">
            <h1 id="hero-heading">Your tasks, everywhere.<br /><span>Agent-ready.</span></h1>
            <div class="hero-description">
              <p>Aven is a local-first task manager with a keyboard-driven TUI for you and a compact CLI for your coding agents. Keep tasks and context together across projects. Work offline, with optional self-hosted, end-to-end encrypted sync across devices.</p>
              <a class="hero-docs" href="/getting-started/">
                Read the docs
                <ArrowRightIcon />
              </a>
            </div>
          </div>
          <div class="install-widget hero-install" id="install">
            <div class="hero-install-row">
              <div class="install-command">
                <span class="prompt" aria-hidden="true">$</span>
                <code>brew install raine/aven/aven</code>
                <button type="button" data-copy-command aria-label="Copy install command">copy</button>
              </div>
              <div class="install-options" role="group" aria-label="Installation method">
                <button type="button" data-method="brew" aria-pressed="true">brew</button>
                <button type="button" data-method="curl" aria-pressed="false">curl</button>
              </div>
            </div>
            <p class="hero-install-hint">then <code>aven</code>, or <code>aven demo</code> to try it with sample data.</p>
            <p class="install-note" data-copy-status role="status"></p>
            <noscript><p class="install-note">For the curl command, see <a href="/getting-started/">installation instructions</a>.</p></noscript>
          </div>
          <figure class="hero-product" data-hero-showcase>
            <div class="hero-tabs" role="tablist" aria-label="Explore Aven" data-pending>
              {heroViews.map((view, index) => (
                <button type="button" role="tab" id={`hero-tab-${view.id}`} aria-controls={`hero-panel-${view.id}`} aria-label={view.label} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>
                  <span class="hero-tab-label">{view.label}</span>
                  <span class="hero-tab-description">{view.caption}</span>
                </button>
              ))}
            </div>
            <div class="screenshot-frame">
              <div class="window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>aven</span></div>
              <div class="hero-panels">
                {heroViews.map((view, index) => (
                  <div id={`hero-panel-${view.id}`} role="tabpanel" aria-labelledby={`hero-tab-${view.id}`} aria-hidden={index !== 0 ? 'true' : 'false'} tabindex="0" inert={index !== 0} hidden={index !== 0}>
                    <img src={view.src} width="1992" height="1322" alt={view.alt} fetchpriority={index === 0 ? 'high' : 'auto'} loading={index === 0 ? 'eager' : 'lazy'} />
                    <p class="hero-caption">{view.caption}</p>
                  </div>
                ))}
              </div>
            </div>
          </figure>
        </section>

        <AgentSessions />

        <section class="section sync-section" aria-labelledby="sync-heading">
          <div class="section-copy">
            <p class="eyebrow">Encrypted sync</p>
            <h2 id="sync-heading">Sync through a server you run.</h2>
            <p>Host it on a home server or VPS and connect over your own network. Devices encrypt tasks before upload, so the server can't read them. Every change lands locally first, and sync catches up when the server is reachable.</p>
            <a class="text-link" href="/sync/">How sync works <ArrowRightIcon /></a>
            <p class="cloud-footnote">No server to run? <a href="https://cloud.aventasks.dev/">Aven Cloud</a> <span class="cloud-preview">free preview</span></p>
          </div>
          <SyncTopology />
        </section>

        <section class="section pair-band" aria-labelledby="iphone-heading">
          <div class="band-copy">
            <p class="eyebrow">Aven for mobile</p>
            <h2 id="iphone-heading">Your queue, in your pocket.</h2>
            <p>Jot a task down on your phone and it's in your terminal queue, not a separate notes app you forget to check. Priorities, projects, and full task details stay in sync, end-to-end encrypted through your server or Aven Cloud. Setup is one QR scan.</p>
          </div>
          <video class="band-video" data-autoplay src="/iphone-pairing.mp4" width="1600" height="900" muted loop playsinline preload="metadata" aria-label={pairingVideoLabel}></video>
          <div class="store-row">
            <a class="store-badge" href={appStoreUrl}><img src="/app-store-badge.svg" width="120" height="40" alt="Download on the App Store" /></a>
            <a class="store-badge play-badge" href={playStoreUrl}><img src="/google-play-badge.svg" width="152" height="45" alt="Get it on Google Play" /></a>
          </div>
        </section>

        <section class="section" id="features" aria-label="Features">
          <div class="feature-grid">
            {features.map((feature) => (
              <a class="feature" href={feature.href}>
                <p class:list={['feature-label', feature.color]}>
                  {feature.label.split(' · ').map((term, index) => (
                    <span class="feature-label-term">{index > 0 && <span class="feature-label-separator">· </span>}{term}</span>
                  ))}
                </p>
                <h3>{feature.title}</h3>
                <p class="feature-description">{feature.description}</p>
              </a>
            ))}
          </div>
        </section>

        <QuickCapture />

        <section class="section testimonials-section" aria-labelledby="testimonials-heading">
          <div class="detail-copy">
            <p class="eyebrow">What people say</p>
            <h2 id="testimonials-heading">Kind words from early users.</h2>
          </div>
          <div class="testimonial-grid">
            {testimonials.map((testimonial) => (
              <figure class:list={['testimonial', { featured: testimonial.featured }]}>
                <blockquote>“{testimonial.quote}”</blockquote>
                <figcaption><a href={testimonial.href}>{testimonial.author}</a> <span>on {testimonial.source}</span></figcaption>
              </figure>
            ))}
          </div>
        </section>

        <section class="closing-section" aria-label="Get started with aven">
          <img src={wordmark.src} width="334" height="102" alt="aven" />
          <p>Inspired by Taskwarrior. Built for my own daily use, shared for yours.</p>
          <a class="text-link closing-comparison" href="/taskwarrior/">Coming from Taskwarrior? See how Aven <span class="comparison-ending">compares <ArrowRightIcon /></span></a>
          <div class="closing-actions">
            <a class="closing-button closing-primary" href="/getting-started/">Get started</a>
            <a class="closing-button" href="https://github.com/raine/aven">View on GitHub</a>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <div><Brand /></div>
        <nav aria-label="Footer navigation"><a href="/getting-started/">Docs</a><a href="/changelog/">Changelog</a><a href="/about/">About</a><a href="/support/">Support</a><a href="/privacy/">Privacy</a><a href="https://github.com/raine/aven">Source <ExternalLinkIcon /></a><a href="https://x.com/aventasksdev">X <ExternalLinkIcon /></a></nav>
      </footer>
    </div>
  </body>
</html>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero-showcase]').forEach((showcase) => {
    const tablist = showcase.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(showcase.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const desktop = window.matchMedia('(min-width: 1001px)');
    const updateOrientation = () => tablist.setAttribute('aria-orientation', desktop.matches ? 'vertical' : 'horizontal');
    updateOrientation();
    desktop.addEventListener('change', updateOrientation);
    const select = (index: number) => {
      tabs.forEach((tab, position) => {
        tab.setAttribute('aria-selected', String(position === index));
        tab.tabIndex = position === index ? 0 : -1;
        panels[position].setAttribute('aria-hidden', String(position !== index));
        panels[position].inert = position !== index;
      });
      panels[index].querySelector<HTMLImageElement>('img')!.loading = 'eager';
      if (!desktop.matches) tabs[index].scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', (event) => {
        let next: number;
        switch (event.key) {
          case 'ArrowDown':
            if (!desktop.matches) return;
            next = (index + 1) % tabs.length;
            break;
          case 'ArrowUp':
            if (!desktop.matches) return;
            next = (index + tabs.length - 1) % tabs.length;
            break;
          case 'ArrowRight': next = (index + 1) % tabs.length; break;
          case 'ArrowLeft': next = (index + tabs.length - 1) % tabs.length; break;
          case 'Home': next = 0; break;
          case 'End': next = tabs.length - 1; break;
          default: return;
        }
        event.preventDefault();
        select(next);
        tabs[next].focus();
      });
    });
    panels.forEach((panel) => { panel.hidden = false; });
    tablist.removeAttribute('data-pending');
  });

  const videoObserver = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      const video = entry.target as HTMLVideoElement;
      if (entry.isIntersecting) video.play().catch(() => {});
      else video.pause();
    }
  }, { threshold: 0.4 });
  document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((video) => videoObserver.observe(video));

  const commands = {
    brew: 'brew install raine/aven/aven',
    curl: 'curl -fsSL https://raw.githubusercontent.com/raine/aven/main/scripts/install | bash',
  };
  document.querySelectorAll<HTMLElement>('.install-widget').forEach((widget) => {
    const command = widget.querySelector<HTMLElement>('.install-command code')!;
    const copyButton = widget.querySelector<HTMLButtonElement>('[data-copy-command]')!;
    const status = widget.querySelector<HTMLElement>('[data-copy-status]')!;
    const methods = widget.querySelectorAll<HTMLButtonElement>('[data-method]');
    const defaultStatus = status.textContent;
    const copyLabel = copyButton.textContent;
    let selection = 0;

    methods.forEach((button) => {
      button.addEventListener('click', () => {
        const method = button.dataset.method as keyof typeof commands;
        selection += 1;
        command.textContent = commands[method];
        methods.forEach((option) => option.setAttribute('aria-pressed', String(option === button)));
        copyButton.textContent = copyLabel;
        status.textContent = defaultStatus;
      });
    });

    copyButton.addEventListener('click', async () => {
      const currentSelection = selection;
      try {
        await navigator.clipboard.writeText(command.textContent!);
        if (currentSelection !== selection) return;
        copyButton.textContent = 'Copied';
        status.textContent = defaultStatus;
      } catch {
        if (currentSelection !== selection) return;
        const range = document.createRange();
        range.selectNodeContents(command);
        const selectedText = window.getSelection();
        selectedText?.removeAllRanges();
        selectedText?.addRange(range);
        status.textContent = 'Clipboard unavailable. Copy the selected command manually.';
      }
    });
  });
</script>
