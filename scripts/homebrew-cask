#!/usr/bin/env bash
# Prints the Homebrew cask for a release's Aven Desktop disk images.
# CHECKSUM_DIR holds the release's .sha256 files.
set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: homebrew-cask VERSION CHECKSUM_DIR" >&2
  exit 2
fi
version=$1
checksum_dir=$2
if [[ ! $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "version must be MAJOR.MINOR.PATCH: $version" >&2
  exit 2
fi

checksum() {
  local file="$checksum_dir/$1.sha256"
  local sum
  sum=$(awk '{print $1; exit}' "$file")
  if [[ ! $sum =~ ^[0-9a-f]{64}$ ]]; then
    echo "invalid checksum in $file" >&2
    exit 1
  fi
  printf '%s\n' "$sum"
}

sha_arm=$(checksum Aven-Desktop-arm64)
sha_intel=$(checksum Aven-Desktop-amd64)

# Uninstalling leaves the background agent's LaunchAgent in place: launchd
# stops it while Aven.app is missing and starts it again when an upgrade or
# reinstall puts the app back. The zap stanza removes that agent, only when
# it runs this cask's app, and regenerable app state. Tasks, configuration
# and sync credentials stay, so reinstalling resumes where the user left off.
cat <<EOF
cask "aven" do
  arch arm: "arm64", intel: "amd64"

  version "${version}"
  sha256 arm:   "${sha_arm}",
         intel: "${sha_intel}"

  url "https://github.com/raine/aven/releases/download/v#{version}/Aven-Desktop-#{arch}.dmg"
  name "Aven"
  desc "Local-first task manager"
  homepage "https://github.com/raine/aven"

  auto_updates true
  depends_on macos: :ventura

  app "Aven.app"
  binary "#{appdir}/Aven.app/Contents/MacOS/aven"

  zap script: {
        executable: "/bin/sh",
        args:       ["-c", <<~SH],
          plist="\$HOME/Library/LaunchAgents/com.raine.aven.daemon.plist"
          [ -f "\$plist" ] || exit 0
          program=\$(/usr/bin/plutil -extract ProgramArguments.0 raw -o - "\$plist" 2>/dev/null) || exit 0
          case \$program in
            "#{appdir}/Aven.app/"*) ;;
            *) exit 0 ;;
          esac
          /bin/launchctl bootout "gui/\$(/usr/bin/id -u)/com.raine.aven.daemon" 2>/dev/null
          /bin/rm -f "\$plist"
        SH
      },
      trash:  [
        "~/.cache/aven",
        "~/Library/Caches/fi.zendit.Aven",
        "~/Library/Preferences/fi.zendit.Aven.plist",
        "~/Library/Saved Application State/fi.zendit.Aven.savedState",
      ]

  caveats <<~EOS
    Aven can keep sending reminders and syncing after you quit it, through a
    background agent. Uninstalling leaves that agent in place, stopped while
    Aven.app is gone, so reinstalling picks up where you left off. To remove
    the agent too, run:
      brew uninstall --zap aven
    Your tasks, configuration and sync credentials stay either way.
  EOS
end
EOF
