#!/usr/bin/env bash
set -euo pipefail

# Use only system tools to evaluate release signatures.
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "usage: verify-macos-release BINARY_OR_APP_OR_DMG [arm64|x86_64]" >&2
  exit 2
fi
binary=$1
architecture=${2:-}
# These are the identity used by login Keychain ACLs across upgrades.
identifier=fi.zendit.Aven
expected_team_identifier=YG824X87Y2

developer_id_requirement="anchor apple generic"
developer_id_requirement+=" and certificate 1[field.1.2.840.113635.100.6.2.6] exists"
developer_id_requirement+=" and certificate leaf[field.1.2.840.113635.100.6.1.13] exists"
developer_id_requirement+=" and certificate leaf[subject.OU] = \"$expected_team_identifier\""

# A disk image carries a Developer ID signature but no code identity.
if [[ -f $binary && $binary == *.dmg ]]; then
  if [[ -n $architecture ]]; then
    echo "a disk image has no architecture; verify its app instead" >&2
    exit 2
  fi
  codesign --verify --strict --verbose=2 "$binary"
  if ! codesign --verify --verbose=2 -R="$developer_id_requirement" "$binary"; then
    echo "disk image signature does not satisfy the expected Developer ID requirement" >&2
    exit 1
  fi
  codesign -d --verbose=4 "$binary" 2>&1
  exit 0
fi

executable=$binary
if [[ -d $binary && $binary == *.app ]]; then
  # Exactly the files assembled by assemble-macos-app plus the bundle seal,
  # and the notarization ticket once stapled.
  expected_layout='Contents
Contents/Info.plist
Contents/MacOS
Contents/MacOS/aven
Contents/Resources
Contents/Resources/Assets.car
Contents/Resources/Aven.icns
Contents/_CodeSignature
Contents/_CodeSignature/CodeResources'
  layout=$(cd "$binary" && find . -mindepth 1 | sed 's|^\./||' | grep -vx 'Contents/CodeResources' | LC_ALL=C sort)
  if [[ -L $binary/Contents/CodeResources ||
        ( -e $binary/Contents/CodeResources && ! -f $binary/Contents/CodeResources ) ||
        $layout != "$expected_layout" ]]; then
    echo "app bundle does not have the expected layout: $binary" >&2
    exit 1
  fi
  executable="$binary/Contents/MacOS/aven"
  if [[ -L $executable || ! -f $executable ]] ||
     [[ $(plutil -extract CFBundleIdentifier raw "$binary/Contents/Info.plist") != "$identifier" ]] ||
     [[ $(plutil -extract CFBundleExecutable raw "$binary/Contents/Info.plist") != aven ]]; then
    echo "app bundle does not identify its aven executable as $identifier" >&2
    exit 1
  fi
elif [[ ! -f $binary ]]; then
  echo "binary or app bundle not found: $binary" >&2
  exit 2
fi
if [[ -n $architecture ]]; then
  case $architecture in
    arm64|x86_64) ;;
    *) echo "unsupported release architecture: $architecture" >&2; exit 2 ;;
  esac
  if [[ $(lipo -archs "$executable") != "$architecture" ]]; then
    echo "release binary does not have the expected architecture: $architecture" >&2
    exit 1
  fi
fi

codesign --verify --strict --verbose=2 "$binary"
signature=$(codesign -d -r- --verbose=4 "$binary" 2>&1)
actual_identifier=$(sed -n 's/^Identifier=//p' <<<"$signature")
team_identifier=$(sed -n 's/^TeamIdentifier=//p' <<<"$signature")
designated_requirement=$(sed -n 's/^designated => //p' <<<"$signature")
if [[ $actual_identifier != "$identifier" ||
      $team_identifier != "$expected_team_identifier" ||
      $designated_requirement == *"cdhash"* ||
      $designated_requirement != *"identifier \"$identifier\""* ]]; then
  echo "release signature does not have the expected stable designated requirement" >&2
  exit 1
fi
if [[ $executable != "$binary" ]]; then
  if ! grep -q '^Info.plist entries=' <<<"$signature" ||
     ! grep -q '^Sealed Resources version=2 ' <<<"$signature"; then
    echo "app bundle signature does not seal its Info.plist and resources" >&2
    exit 1
  fi
fi

release_requirement="identifier \"$identifier\" and $developer_id_requirement"
if ! codesign --verify --verbose=2 -R="$release_requirement" "$binary"; then
  echo "release signature does not satisfy the expected Developer ID requirement" >&2
  exit 1
fi
printf '%s\n' "$signature"
