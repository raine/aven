#!/usr/bin/env bash
# Checks a Linux Desktop release archive from scripts/package-linux-desktop:
# its layout and the executable's architecture and glibc floor; then installs
# it with scripts/install-desktop, opens the installed app under Xvfb, and
# uninstalls it, keeping the data the app wrote. Needs readelf, objdump,
# python3, Xvfb, xwininfo, setsid and pkill. Everything it runs uses a
# throwaway HOME and XDG directories.
set -euo pipefail

if [[ $# -ne 2 || ! $2 =~ ^(x86_64|aarch64)$ ]]; then
  echo "usage: check-linux-desktop-release ARCHIVE x86_64|aarch64" >&2
  exit 2
fi
archive=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
arch=$2
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# Ubuntu 22.04's, the oldest base the release builds on. Raising it drops
# distributions; scripts/install-desktop checks the same floor.
max_glibc=2.35

fail() {
  echo "::error::$*" >&2
  exit 1
}

tmp=$(mktemp -d)
app_pid=""
xvfb_pid=""
# Stops whatever the check started and exits with the check's own status:
# errexit is off here, since finding nothing left to stop is not a failure.
cleanup() {
  local status=$?
  set +e
  if [[ -n $app_pid ]]; then
    kill "$app_pid" 2>/dev/null
    wait "$app_pid" 2>/dev/null
  fi
  pkill -KILL -f "^$tmp/" 2>/dev/null
  if [[ -n $xvfb_pid ]]; then
    kill "$xvfb_pid" 2>/dev/null
    wait "$xvfb_pid" 2>/dev/null
  fi
  rm -rf "$tmp"
  exit "$status"
}
trap cleanup EXIT

entries=$(python3 -I -c 'import sys, tarfile
for m in tarfile.open(sys.argv[1]):
    kind = "dir" if m.isdir() else "file" if m.isreg() else "other"
    print(kind, oct(m.mode & 0o777), m.name)' "$archive")
printf '%s\n' "$entries"
if grep -v '^\(dir\|file\) [0-7o]* aven-desktop\(/\|$\)' <<<"$entries" | grep -q .; then
  fail "archive may hold only directories and regular files under aven-desktop/"
fi
grep -q '^file 0o755 aven-desktop/aven$' <<<"$entries" || fail "aven-desktop/aven is missing or not executable"
grep -q '^file 0o644 aven-desktop/share/applications/fi.zendit.Aven.desktop$' <<<"$entries" ||
  fail "the launcher is missing"
grep -q '^file 0o644 aven-desktop/share/icons/hicolor/scalable/apps/fi.zendit.Aven.svg$' <<<"$entries" ||
  fail "the scalable icon is missing"

tar -xzf "$archive" -C "$tmp"
app="$tmp/aven-desktop/aven"

machine=$(readelf -h "$app" | sed -n 's/^ *Machine: *//p')
case "$arch:$machine" in
  x86_64:*X86-64* | aarch64:AArch64) ;;
  *) fail "expected an $arch executable, found $machine" ;;
esac
needed=$(objdump -T "$app" | grep -o 'GLIBC_[0-9][0-9.]*' | sed 's/GLIBC_//' | sort -uV | tail -n 1)
echo "requires glibc $needed"
if [[ $(printf '%s\n%s\n' "$needed" "$max_glibc" | sort -V | tail -n 1) != "$max_glibc" ]]; then
  fail "the executable requires glibc $needed, above the supported $max_glibc"
fi

"$app" --version </dev/null
"$app" --help </dev/null >/dev/null

root="$tmp/session"
mkdir -p "$root"/{home,config,data,state,cache,runtime}
chmod 700 "$root/runtime"
session=(env -i PATH=/usr/bin:/bin HOME="$root/home" XDG_CONFIG_HOME="$root/config"
  XDG_DATA_HOME="$root/data" XDG_STATE_HOME="$root/state" XDG_CACHE_HOME="$root/cache"
  XDG_RUNTIME_DIR="$root/runtime")
installed="$root/data/aven/desktop/aven"
entry="$root/data/applications/fi.zendit.Aven.desktop"

# Existing settings and tasks, which installing and uninstalling must keep.
mkdir -p "$root/home/.config/aven" "$root/state/aven"
printf 'keep\n' >"$root/home/.config/aven/marker"
printf 'keep\n' >"$root/state/aven/marker"

"${session[@]}" bash "$script_dir/install-desktop" --archive "$archive"
[[ $(readlink "$root/home/.local/bin/aven") == "$installed" ]] || fail "the aven link does not point at the app"
"$root/home/.local/bin/aven" --version </dev/null
grep -Fqx "Exec=\"$installed\"" "$entry" || fail "the launcher does not run the app: $(grep '^Exec=' "$entry")"
grep -Fqx "TryExec=$installed" "$entry" || fail "the launcher's TryExec is not the app"
[[ -f $root/data/icons/hicolor/scalable/apps/fi.zendit.Aven.svg ]] || fail "the icons were not installed"
if command -v desktop-file-validate >/dev/null 2>&1; then
  desktop-file-validate "$entry"
fi

# The launcher runs the app with no arguments, no terminal and a display. GL
# is forced because Mesa's software Vulkan renders nothing visible on Xvfb.
Xvfb :97 -screen 0 1280x800x24 -nolisten tcp >"$tmp/xvfb.log" 2>&1 &
xvfb_pid=$!
dbus=()
if command -v dbus-run-session >/dev/null 2>&1; then
  dbus=(dbus-run-session --)
fi
"${session[@]}" DISPLAY=:97 AVEN_SYNC_DISABLED=1 VK_ICD_FILENAMES=/nonexistent.json \
  "${dbus[@]}" setsid "$installed" </dev/null >"$tmp/app.log" 2>&1 &
app_pid=$!

window=""
for _ in $(seq 60); do
  kill -0 "$app_pid" 2>/dev/null || break
  window=$(DISPLAY=:97 xwininfo -root -tree 2>/dev/null | grep '"Aven"' || true)
  [[ -n $window ]] && break
  sleep 1
done
if [[ -z $window ]] || ! kill -0 "$app_pid" 2>/dev/null; then
  cat "$tmp/app.log" >&2
  fail "the app did not open a window"
fi
echo "window: $window"
sleep 3
kill -0 "$app_pid" 2>/dev/null || { cat "$tmp/app.log" >&2; fail "the app exited after opening its window"; }

pkill -f "^$installed\$" || true
for _ in $(seq 20); do
  pgrep -f "^$installed\$" >/dev/null || break
  sleep 0.5
done
pkill -KILL -f "^$installed\$" || true
wait "$app_pid" 2>/dev/null || true
app_pid=""
state_before=$(cd "$root/state" && find . -type f | LC_ALL=C sort)
[[ -n $(find "$root/state/aven" -name '*.sqlite') ]] || fail "the app wrote no database"

"${session[@]}" bash "$script_dir/install-desktop" --uninstall
[[ ! -e $root/data/aven/desktop && ! -L $root/home/.local/bin/aven && ! -e $entry ]] ||
  fail "uninstall left the app, the link or the launcher"
[[ ! -e $root/data/aven ]] || fail "uninstall left the app's empty directory"
[[ -z $(find "$root/data/icons" -name 'fi.zendit.Aven.*') ]] || fail "uninstall left icons"
[[ $(cd "$root/state" && find . -type f | LC_ALL=C sort) == "$state_before" ]] || fail "uninstall changed the app's data"
[[ -f $root/home/.config/aven/marker ]] || fail "uninstall removed settings"
echo "ok: $archive"
