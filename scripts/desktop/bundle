#!/usr/bin/env bash
# Builds "Aven Dev.app" around the integrated `aven`, laid out as Aven.app is
# but with the isolation guard compiled in. Launching needs a real bundle: a bare
# binary stays behind other windows. The app must never use Aven.app's name or
# identifier, which notifications, updates and daemon migration key on.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/env"

"$desktop_repo/scripts/desktop/cargo" build --bin aven-desktop >&2
"$desktop_repo/scripts/desktop/cargo" build --package aven --features desktop-dev --bin aven >&2

bundle="$desktop_crate/target/Aven Dev.app"
contents="$bundle/Contents"
mkdir -p "$contents/MacOS"
cp "$desktop_repo/macos/Info.plist" "$contents/Info.plist"
plutil -replace CFBundleDisplayName -string "Aven Dev" "$contents/Info.plist"
plutil -replace CFBundleName -string "Aven Dev" "$contents/Info.plist"
plutil -replace CFBundleIdentifier -string fi.zendit.Aven.dev "$contents/Info.plist"
plutil -insert CFBundleShortVersionString -string 0.0.0 "$contents/Info.plist"
plutil -lint "$contents/Info.plist" >/dev/null
mkdir -p "$contents/Resources"
cp "$desktop_repo/macos/Resources/Assets.car" "$desktop_repo/macos/Resources/Aven.icns" "$contents/Resources/"
# Replaced rather than written over, which fails while the app runs.
rm -f "$contents/MacOS/aven"
cp "$desktop_bin/aven" "$contents/MacOS/aven"
xattr -cr "$bundle"
codesign --force --sign - "$bundle" 2>/dev/null
printf '%s\n' "$bundle"
