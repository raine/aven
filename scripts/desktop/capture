#!/usr/bin/env bash
# Captures paired scenes and box measurements on a disposable database.
#
# usage: capture OUTPUT [SCENE]
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/env"

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "usage: capture OUTPUT [SCENE]" >&2
  exit 2
fi
output=$(python3 -c 'import os, sys; print(os.path.abspath(sys.argv[1]))' "$1")
"$desktop_repo/scripts/desktop/cargo" build --features capture >&2
root=$(mktemp -d "${TMPDIR:-/tmp}/aven-desktop.XXXXXX")
trap 'rm -rf "$root"' EXIT
write_isolated_config "$root"
scratch=$(isolation_path "$root" scratch)
mkdir "$scratch"
TMPDIR="$scratch" run_isolated "$root" "$desktop_bin/aven-desktop-capture" run "$output" "${@:2}"
