#!/usr/bin/env python3
"""Stands up a disposable sync pair around the desktop app, for manual proof.

  app-proof start               create server, clients a and b, print ROOT
  app-proof cli ROOT a|b ARGS   run the CLI as a client
  app-proof daemon ROOT         run a daemon for client a until `undaemon`
  app-proof undaemon ROOT       stop that daemon
  app-proof stop ROOT           stop everything and remove ROOT

Launch the app on client a with AVEN_DESKTOP_ROOT=ROOT/a scripts/desktop/launch.
It shares a's database and file keys, so it syncs as that client.
"""
import importlib.machinery
import importlib.util
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path

sys.dont_write_bytecode = True
REPO = Path(__file__).resolve().parents[2]
loader = importlib.machinery.SourceFileLoader("sync_proof", str(REPO / "scripts/desktop/sync-proof"))
spec = importlib.util.spec_from_loader("sync_proof", loader)
sync_proof = importlib.util.module_from_spec(spec)
loader.exec_module(sync_proof)


class Client(sync_proof.Client):
    """A client whose directory already exists, from an earlier command."""

    def __init__(self, binary, root, name):
        self.binary, self.root, self.name = binary, root / name, name
        self.root.mkdir(exist_ok=True)
        self.paths = sync_proof.isolation_paths(self.root)
        for path in ("database", "logs", "server_storage"):
            Path(self.paths[path]).parent.mkdir(parents=True, exist_ok=True)



def detached(*args):
    """Outlives this command. A child's pipes close when its parent exits, so
    each long-lived worker keeps its own holder process."""
    subprocess.Popen(
        [__file__, *map(str, args)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def wait_for_server(bind):
    host, port = bind.split(":")
    for _ in range(300):
        try:
            socket.create_connection((host, int(port)), timeout=1).close()
            return
        except OSError:
            time.sleep(0.1)
    sys.exit("server did not start listening")


def start():
    subprocess.run([REPO / "scripts/desktop/cargo", "build", "--bin", "aven-desktop"], check=True)
    binary = sync_proof.worker_binary()
    root = Path(tempfile.mkdtemp(prefix="aven-app-proof-")).resolve()
    with socket.socket() as probe:
        probe.bind(("127.0.0.1", 0))
        bind = f"127.0.0.1:{probe.getsockname()[1]}"
    url = f"http://{bind}"
    operator, a, b = (Client(binary, root, name) for name in ("operator", "a", "b"))
    data = str(Path(operator.paths["server_storage"]) / "sync-server.sqlite")
    setup = sync_proof.line_with(
        operator.ok(["server", "setup", "--data", data, "--url", url]), "aven-setup:"
    )
    (root / "proof.json").write_text(json.dumps({"binary": binary, "data": data, "bind": bind}))
    detached("run-server", root)
    wait_for_server(bind)
    a.ok(["add", "Seed task one", "--project", "app"])
    a.ok(["add", "Seed task two", "--project", "app", "--priority", "high"])
    a.ok(["sync", "setup", "--yes"], setup)
    invite = a.process(["sync", "invite"], stderr=subprocess.DEVNULL)
    invitation = next(line.strip() for line in invite.stdout if line.startswith("AVEN:"))
    b.ok(["sync", "join", "--yes"], invitation)
    invite.wait(timeout=120)
    print(root)


def state(root):
    return json.loads((root / "proof.json").read_text())


def client(root, name):
    return Client(state(root)["binary"], root, name)


def hold(root, name, child, log=subprocess.DEVNULL):
    saved = state(root)
    saved[name] = child.pid
    (root / "proof.json").write_text(json.dumps(saved))
    for line in child.stdout:
        if log != subprocess.DEVNULL:
            log.write(line)
            log.flush()


def run_server(root):
    saved = state(root)
    arguments = ["server", "--data", saved["data"], "--bind", saved["bind"]]
    hold(root, "server", client(root, "operator").process(arguments, stderr=subprocess.DEVNULL))


def run_daemon(root):
    a = client(root, "a")
    config = root / "daemon-config"
    config.mkdir(exist_ok=True)
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as probe:
        probe.bind(("127.0.0.1", 0))
        wake = f"127.0.0.1:{probe.getsockname()[1]}"
    (config / "config.yaml").write_text(
        f'sync:\n  enabled: true\n  interval_seconds: 2\ndaemon:\n  wake_addr: "{wake}"\n'
    )
    a.paths = {**a.paths, "config_dir": str(config)}
    log = (root / "daemon.log").open("w")
    hold(root, "daemon", a.process(["daemon"], stderr=log), log)


def wait_for_daemon(root):
    log = root / "daemon.log"
    for _ in range(300):
        if log.exists() and "daemon db=" in log.read_text():
            return
        time.sleep(0.1)
    sys.exit(f"daemon did not start, see {log}")


def stop_process(pid):
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass


def undaemon(root):
    saved = state(root)
    stop_process(saved.pop("daemon"))
    (root / "proof.json").write_text(json.dumps(saved))


def stop(root):
    saved = state(root)
    for name in ("server", "daemon"):
        if name in saved:
            stop_process(saved[name])
    shutil.rmtree(root)


def main():
    match sys.argv[1:]:
        case ["start"]:
            start()
        case ["cli", root, name, *args]:
            print(client(Path(root), name).ok(args), end="")
        case ["daemon", root]:
            detached("run-daemon", root)
            wait_for_daemon(Path(root))
        case ["run-server", root]:
            run_server(Path(root))
        case ["run-daemon", root]:
            run_daemon(Path(root))
        case ["undaemon", root]:
            undaemon(Path(root))
        case ["stop", root]:
            stop(Path(root))
        case _:
            sys.exit(__doc__)


main()
