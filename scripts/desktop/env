# shellcheck shell=bash
# Sourced by desktop scripts. `isolated_environment ROOT` prints the only
# variables a development process may see from this repository's tooling,
# dropping AVEN_DB, AVEN_DEV_DB and AVEN_SYNC_DISABLED from direnv.
desktop_repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
desktop_crate="$desktop_repo/crates/aven-desktop"
desktop_bin="$desktop_crate/target/bin"

isolated_environment() {
  local root=$1
  printf '%s\n' \
    "AVEN_DESKTOP_ROOT=$root" \
    "HOME=$root/home" \
    "XDG_STATE_HOME=$root/state" \
    "XDG_CONFIG_HOME=$root/config" \
    "XDG_CACHE_HOME=$root/cache" \
    "AVEN_CONFIG_DIR=$root/config/aven" \
    "AVEN_DB=$root/state/aven/db.sqlite" \
    "AVEN_LOG_FILE=$root/state/aven/logs/desktop.log"
}

# Runs a command with a clean environment plus the isolated variables.
run_isolated() {
  local root=$1
  shift
  local variables=()
  while IFS= read -r line; do variables+=("$line"); done < <(isolated_environment "$root")
  env -i PATH="$PATH" TMPDIR="${TMPDIR:-/tmp}" "${variables[@]}" "$@"
}

# Prints one path from the guard's validated layout, or refuses the root. Every
# path a script writes comes from here. Takes the name from --print-paths.
isolation_path() {
  local root=$1 name=$2 listing
  listing=$(run_isolated "$root" "$desktop_bin/aven-desktop" --print-paths)
  sed -n "s/^$name=//p" <<<"$listing"
}

free_loopback_port() {
  python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])'
}

# Writes the launch's config, with its own wake port and no automatic sync.
write_isolated_config() {
  local root=$1 config
  config=$(isolation_path "$root" config_file)
  mkdir -p "$(dirname "$config")"
  cat >"$config" <<YAML
sync:
  enabled: false
daemon:
  wake_addr: "127.0.0.1:$(free_loopback_port)"
YAML
}
