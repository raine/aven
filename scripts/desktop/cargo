#!/usr/bin/env bash
# Runs Cargo for crates/aven-desktop against a build cache shared by worktrees.
# Git dependencies such as GPUI hash identically across worktrees, so they build
# once. Path dependencies hash by path, so each worktree keeps its own.
#
# The final binary path is shared by every worktree, so a lock spans the build
# and the copy into this worktree's target/bin.
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
crate="$repo/crates/aven-desktop"
cache="${AVEN_DESKTOP_CACHE:-$HOME/Library/Caches/aven-desktop}"
lock="$cache/build.pid"
mkdir -p "$cache"

# The lock is a symlink naming its holder, created atomically. A killed holder
# cannot release it, so a lock whose process is gone is cleared.
release_lock() { rm -f "$lock"; }
waited=0
until ln -s "$$" "$lock" 2>/dev/null; do
  holder=$(readlink "$lock" 2>/dev/null || true)
  if [[ -n $holder ]] && ! kill -0 "$holder" 2>/dev/null; then
    echo "clearing desktop build lock of exited process $holder" >&2
    mv -f "$lock" "$lock.stale.$$" 2>/dev/null && rm -f "$lock.stale.$$"
    continue
  fi
  if ((waited % 60 == 0)); then echo "waiting for desktop build lock: $lock" >&2; fi
  sleep 1
  waited=$((waited + 1))
done
trap release_lock EXIT

cd "$crate"
export CARGO_TARGET_DIR="$cache/target"
export SQLX_OFFLINE=true
cargo "$@"

if [[ ${1:-} == build ]]; then
  mkdir -p "$crate/target/bin"
  for name in aven-desktop aven-desktop-capture; do
    built="$CARGO_TARGET_DIR/debug/$name"
    [[ -x $built ]] || continue
    # A running binary must be replaced, not written over.
    rm -f "$crate/target/bin/$name"
    cp "$built" "$crate/target/bin/$name"
  done
fi
