#!/usr/bin/env bash
# Packages a Linux Desktop build as ARCHIVE: one aven-desktop/ directory
# holding the executable and the XDG launcher and icons that
# scripts/install-desktop installs.
set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: package-linux-desktop BINARY ARCHIVE" >&2
  exit 2
fi
binary=$1
archive=$2
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
linux="$script_dir/../linux"

if [[ $(basename "$binary") != aven || -L $binary || ! -f $binary ]]; then
  echo "expected a regular file named aven: $binary" >&2
  exit 1
fi

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
root="$stage/aven-desktop"
mkdir -p "$root/share/applications"
install -m 0755 "$binary" "$root/aven"
install -m 0644 "$linux/fi.zendit.Aven.desktop" "$root/share/applications/"
(cd "$linux" && find icons -type f) | while read -r icon; do
  mkdir -p "$root/share/$(dirname "$icon")"
  install -m 0644 "$linux/$icon" "$root/share/$icon"
done

archive_dir=$(cd "$(dirname "$archive")" && pwd)
(cd "$stage" && find aven-desktop | LC_ALL=C sort) >"$stage/entries"
tar -C "$stage" --no-recursion -czf "$archive_dir/$(basename "$archive")" -T "$stage/entries"
