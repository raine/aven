#!/usr/bin/env bash
set -euo pipefail

# Opens the app on a fresh demo database, apart from real data: its own
# identifier, home, config, state and data directories, with sync disabled.
#
#   demo-app            the installed /Applications/Aven.app
#   demo-app --debug    a debug build of this checkout
#   demo-app --empty    an empty database, which opens on the welcome

usage() {
  echo "usage: demo-app [--debug] [--empty]" >&2
  exit 2
}

debug=false
empty=false
for arg in "$@"; do
  case $arg in
    --debug) debug=true ;;
    --empty) empty=true ;;
    *) usage ;;
  esac
done

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
root=$(mktemp -d /tmp/aven-demo.XXXXXX)
mkdir -p "$root/home" "$root/config" "$root/state" "$root/data"
app="$root/AvenDemo.app"

if $debug; then
  (cd "$repo" && SQLX_OFFLINE=true cargo build --offline --features desktop)
  "$repo/scripts/assemble-macos-app" "$repo/target/debug/aven" 0.0.0 "$root" >/dev/null
  mv "$root/Aven.app" "$app"
  name="Aven Demo (debug)"
else
  source=/Applications/Aven.app
  if [[ ! -x $source/Contents/MacOS/aven ]]; then
    echo "error: $source is not installed" >&2
    exit 1
  fi
  cp -R "$source" "$app"
  name="Aven Demo"
fi

# Its own identifier lets it run beside the installed app with its own
# preferences.
plist="$app/Contents/Info.plist"
plutil -replace CFBundleIdentifier -string fi.zendit.AvenDemo "$plist"
plutil -replace CFBundleName -string "$name" "$plist"
plutil -replace CFBundleDisplayName -string "$name" "$plist"
codesign --force --sign - "$app" 2>/dev/null

isolated=(
  HOME="$root/home"
  XDG_CONFIG_HOME="$root/config"
  XDG_STATE_HOME="$root/state"
  XDG_DATA_HOME="$root/data"
  AVEN_DB="$root/demo.sqlite"
  AVEN_DEV_DB="$root/demo.sqlite"
  AVEN_SYNC_DISABLED=1
)
if ! $empty; then
  env "${isolated[@]}" "$app/Contents/MacOS/aven" internal demo-snapshot \
    --output "$root/demo.sqlite" >/dev/null
fi

open_args=()
for setting in "${isolated[@]}"; do
  open_args+=(--env "$setting")
done
open -n "${open_args[@]}" "$app"
echo "$name opened from $root"
