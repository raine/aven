#!/usr/bin/env bash
set -euo pipefail

# Opens the app on a fresh demo database, apart from real data: its own
# identifier, home, config, state and data directories, with sync disabled.
# The demo config carries only agent.task_intake from the real config.
#
#   demo-app            the installed /Applications/Aven.app
#   demo-app --debug    a debug build of this checkout
#   demo-app --empty    an empty database, which opens on the welcome

usage() {
  echo "usage: demo-app [--debug] [--empty]" >&2
  exit 2
}

debug=false
empty=false
for arg in "$@"; do
  case $arg in
    --debug) debug=true ;;
    --empty) empty=true ;;
    *) usage ;;
  esac
done

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
root=$(mktemp -d /tmp/aven-demo.XXXXXX)
mkdir -p "$root/home" "$root/config" "$root/state" "$root/data"
app="$root/AvenDemo.app"

if $debug; then
  (cd "$repo" && SQLX_OFFLINE=true cargo build --offline --features desktop)
  "$repo/scripts/assemble-macos-app" "$repo/target/debug/aven" 0.0.0 "$root" desktop >/dev/null
  mv "$root/Aven.app" "$app"
  name="Aven Demo (debug)"
else
  source=/Applications/Aven.app
  if [[ ! -x $source/Contents/MacOS/aven ]]; then
    echo "error: $source is not installed" >&2
    exit 1
  fi
  cp -R "$source" "$app"
  name="Aven Demo"
fi

# Its own identifier lets it run beside the installed app with its own
# preferences.
plist="$app/Contents/Info.plist"
plutil -replace CFBundleIdentifier -string fi.zendit.AvenDemo "$plist"
plutil -replace CFBundleName -string "$name" "$plist"
plutil -replace CFBundleDisplayName -string "$name" "$plist"
codesign --force --sign - "$app" 2>/dev/null

# Create with AI needs an agent, so the demo uses the one from the real config.
# The agent runs with the real HOME so that it finds its own login.
real_config="${AVEN_CONFIG_DIR:-$HOME/.config/aven}/config.yaml"
if [[ -f $real_config ]] && command -v yq >/dev/null &&
  [[ $(yq '.agent.task_intake.command // ""' "$real_config") ]]; then
  mkdir -p "$root/home/.config/aven"
  REAL_HOME=$HOME yq '
    {"agent": {"task_intake": .agent.task_intake}}
    | .agent.task_intake.args = ["HOME=" + strenv(REAL_HOME), .agent.task_intake.command]
      + (.agent.task_intake.args // [])
    | .agent.task_intake.command = "/usr/bin/env"
  ' "$real_config" >"$root/home/.config/aven/config.yaml"
elif [[ -f $real_config ]] && ! command -v yq >/dev/null; then
  echo "warning: yq is not installed, so Create with AI has no agent" >&2
fi

isolated=(
  HOME="$root/home"
  XDG_CONFIG_HOME="$root/config"
  XDG_STATE_HOME="$root/state"
  XDG_DATA_HOME="$root/data"
  AVEN_DB="$root/demo.sqlite"
  AVEN_DEV_DB="$root/demo.sqlite"
  AVEN_SYNC_DISABLED=1
)
# A debug build would otherwise find the installed app in /Applications and
# ask to be moved there before opening.
if $debug; then
  mkdir -p "$root/applications"
  isolated+=(AVEN_DEV_APPLICATIONS="$root/applications")
fi
if ! $empty; then
  env "${isolated[@]}" "$app/Contents/MacOS/aven" internal demo-snapshot \
    --output "$root/demo.sqlite" >/dev/null
fi

open_args=()
for setting in "${isolated[@]}"; do
  open_args+=(--env "$setting")
done
open -n "${open_args[@]}" "$app"
echo "$name opened from $root"
